{
  "name": "flow_matching_default",
  "output_dir": "outputs/flow_matching",
  "model": {
    "model_type": "FlowMatching",
    "model_args": {
      "data_dim": 80,
      "hidden_dim": 256,
      "num_layers": 6,
      "num_heads": 8,
      "dropout": 0.1,
      "sigma": 1e-5,
      "time_scheduler": "linear",
      "solver_method": "euler"
    }
  },
  "train": {
    "learning_rate": 1e-4,
    "batch_size": 16,
    "max_epochs": 100,
    "gradient_clip_val": 1.0,
    "n_steps_inference": 10
  },
  "data": {
    "sample_rate": 22050,
    "n_fft": 1024,
    "hop_length": 256,
    "n_mel": 80
  }
}